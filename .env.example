NODE_ENV=development
PORT=4000

# Pooled connection (port 6543) — used by the app at runtime via PgBouncer
DATABASE_URL=postgresql://postgres.password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used for migrations and DDL commands
DIRECT_URL=postgresql://postgres.password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

REDIS_URL=redis://:your_password@localhost:6379

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=post-images

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

BCRYPT_SALT_ROUNDS=12
MAX_IMAGE_SIZE_MB=10
